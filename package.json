{
  "name": "asel-cosmetics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src tests scripts next.config.ts playwright.config.ts postcss.config.mjs eslint.config.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "assets:inventory": "node scripts/inventory-assets.mjs",
    "store:setup": "node --experimental-strip-types scripts/setup-store.mjs",
    "store:backup": "node scripts/backup-store.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.48.0",
    "zustand": "5.0.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "@playwright/test": "1.63.0"
  }
}
