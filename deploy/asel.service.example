[Unit]
Description=Asel Cosmetics
After=network.target

[Service]
Type=simple
User=asel
Group=asel
WorkingDirectory=/opt/asel
Environment=NODE_ENV=production
Environment=ASEL_DATA_DIR=/var/lib/asel
Environment=ASEL_PUBLIC_ORIGIN=https://your-store.example
Environment=NEXT_PUBLIC_SITE_URL=https://your-store.example
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
